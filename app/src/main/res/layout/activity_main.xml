<?xml version="1.0" encoding="utf-8"?>
<ch.florian.tagescode.FitScreenLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="32dp"
        android:paddingEnd="22dp"
        android:paddingBottom="12dp">

        <ImageView
    android:id="@+id/videojetLogo"
    android:layout_width="225dp"
    android:layout_height="60dp"
    android:adjustViewBounds="true"
    android:contentDescription="@string/videojet_logo_description"
    android:scaleType="fitCenter"
    android:src="@drawable/videojet_logo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/code_card_background"
            android:elevation="4dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/codeLabelView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp"
                android:text="@string/code_today_label" />
            <TextView
                android:id="@+id/codeView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:text="------"
                android:textColor="@color/text_primary"
                android:textSize="68sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dateView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="18sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">
      <LinearLayout
    android:id="@+id/otherDateButton"
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="56dp"
    android:background="@drawable/button_primary"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="23dp"
        android:layout_height="23dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_calendar"
        android:tint="@color/accent_text" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/select_date_clean"
        android:textColor="@color/accent_text"
        android:textSize="17sp" />

</LinearLayout>

        <Button
            android:id="@+id/todayButton"
            android:layout_width="88dp"
            android:layout_height="56dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/button_secondary"
            android:minWidth="0dp"
            android:text="@string/today"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/section_card_background"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/additional_codes"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/yesterdayCodeView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/code_row_background"
                android:fontFamily="sans-serif-medium"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/code2000View"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/code_row_background"
                android:fontFamily="sans-serif-medium"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/code2001View"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/code_row_background"
                android:fontFamily="sans-serif-medium"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/code2006View"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/code_row_background"
                android:fontFamily="sans-serif-medium"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

        </LinearLayout>
        <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:contentDescription="@string/swiss_badge_description"
            android:src="@drawable/ic_swiss_badge" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/developed_by"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/dataStatusView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center"
        android:textSize="11sp"
        android:textColor="@color/text_secondary" />
    <TextView
        android:id="@+id/buildInfoView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

</LinearLayout>

    </LinearLayout>

</ch.florian.tagescode.FitScreenLayout>
